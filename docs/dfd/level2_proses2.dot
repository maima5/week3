digraph L2 { labelloc=t; label="DFD Level 2 - Proses 2.0 Transfer Pulsa"; fontsize=14
graph [rankdir=LR, fontname="Helvetica", nodesep=0.6, ranksep=0.9, pad=0.3]
node [fontname="Helvetica", fontsize=11]
edge [fontname="Helvetica", fontsize=9]
U [label="Pelanggan\n(Pengirim)", shape=box, style=filled, fillcolor="#f2f2f2"]
P1 [label="1.0 Tampilkan\nMenu Utama", shape=ellipse, style=dashed]
P6 [label="6.0 Kirim\nNotifikasi", shape=ellipse, style=dashed]
P21 [label="2.1\nValidasi\nNomor Tujuan", shape=ellipse, style=filled, fillcolor="#dbe9ff"]
P22 [label="2.2\nValidasi\nNominal", shape=ellipse, style=filled, fillcolor="#dbe9ff"]
P23 [label="2.3\nKonfirmasi\nTransfer", shape=ellipse, style=filled, fillcolor="#dbe9ff"]
P24 [label="2.4\nEksekusi\nTransfer", shape=ellipse, style=filled, fillcolor="#dbe9ff"]
D1 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD SIDES="TB" BORDER="2">D1 Data_Pelanggan</TD></TR></TABLE>>]
D2 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD SIDES="TB" BORDER="2">D2 Log_Transaksi</TD></TR></TABLE>>]
P1 -> P21 [label="pilihan 1"]
U -> P21 [label="nomor_tujuan"]
D1 -> P21 [label="data_penerima"]
P21 -> U [label="pesan_error /\nprompt nominal"]
P21 -> P22 [label="nomor_valid"]
U -> P22 [label="nominal"]
D1 -> P22 [label="saldo_pengirim"]
P22 -> U [label="pesan_error"]
P22 -> P23 [label="nominal_valid"]
P23 -> U [label="ringkasan + 1.Ya/2.Batal"]
U -> P23 [label="konfirmasi"]
P23 -> P24 [label="konfirmasi_ya"]
P23 -> U [label="pesan 'dibatalkan'"]
P24 -> D1 [label="update saldo\npengirim & penerima"]
P24 -> D2 [label="data_transaksi"]
P24 -> U [label="hasil_transfer"]
P24 -> P6 [label="data_transaksi"]
}
