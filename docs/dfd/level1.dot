digraph L1 { labelloc=t; label="DFD Level 1 - Layanan *858#"; fontsize=14
graph [rankdir=LR, fontname="Helvetica", nodesep=0.6, ranksep=0.9, pad=0.3]
node [fontname="Helvetica", fontsize=11]
edge [fontname="Helvetica", fontsize=9]
U [label="Pelanggan\n(Pengirim)", shape=box, style=filled, fillcolor="#f2f2f2"]
S [label="SMS Gateway", shape=box, style=filled, fillcolor="#f2f2f2"]
P1 [label="1.0\nTampilkan\nMenu Utama", shape=ellipse, style=filled, fillcolor="#dbe9ff"]
P2 [label="2.0\nTransfer\nPulsa", shape=ellipse, style=filled, fillcolor="#dbe9ff"]
P3 [label="3.0\nMinta\nPulsa", shape=ellipse, style=filled, fillcolor="#dbe9ff"]
P4 [label="4.0\nKelola\nAuto TP", shape=ellipse, style=filled, fillcolor="#dbe9ff"]
P5 [label="5.0\nCek Kupon\nUndian TP", shape=ellipse, style=filled, fillcolor="#dbe9ff"]
P6 [label="6.0\nKirim\nNotifikasi", shape=ellipse, style=filled, fillcolor="#dbe9ff"]
D1 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD SIDES="TB" BORDER="2">D1 Data_Pelanggan</TD></TR></TABLE>>]
D2 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD SIDES="TB" BORDER="2">D2 Log_Transaksi</TD></TR></TABLE>>]
D3 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD SIDES="TB" BORDER="2">D3 Data_AutoTP</TD></TR></TABLE>>]
U -> P1 [label="kode_ussd"]
P1 -> U [label="menu_utama"]
U -> P1 [label="pilihan_menu"]
P1 -> D1 [dir=back, label="status pelanggan", style=dashed, arrowhead=none]
P1 -> P2 [label="pilihan 1"]
P1 -> P3 [label="pilihan 2"]
P1 -> P4 [label="pilihan 3/4/5"]
P1 -> P5 [label="pilihan 6"]
U -> P2 [label="nomor_tujuan, nominal,\nkonfirmasi"]
P2 -> U [label="prompt, pesan_error,\nhasil_transfer"]
U -> P3 [label="nomor_pemberi"]
P3 -> U [label="hasil_permintaan"]
U -> P4 [label="data_autotp"]
P4 -> U [label="daftar / status"]
P5 -> U [label="jumlah_kupon"]
P2 -> D1 [label="update saldo"]
D1 -> P2 [label="data_pelanggan"]
P2 -> D2 [label="data_transaksi"]
P3 -> D2 [label="data_permintaan"]
D1 -> P3 [label="data_pelanggan"]
P4 -> D3 [dir=both, label="data_autotp"]
D2 -> P5 [label="data_transaksi"]
P2 -> P6 [label="data_transaksi"]
P3 -> P6 [label="data_permintaan"]
P6 -> S [label="notifikasi_sms"]
}
